{
  "cases": [
    {
      "name": "core_release_and_adopt",
      "agents": [
        {
          "key": "p",
          "has_steer": true
        }
      ],
      "runs": [
        {
          "parent": "p",
          "adopt_id": "deleg_core_1"
        }
      ],
      "ops": [
        {
          "op": "register",
          "run": 0
        },
        {
          "op": "live",
          "key": "p"
        },
        {
          "op": "steer",
          "key": "p",
          "text": "change of plans"
        },
        {
          "op": "released",
          "run": 0
        },
        {
          "op": "notice",
          "id": "deleg_core_1"
        },
        {
          "op": "receipt",
          "ids": [
            "deleg_core_1"
          ],
          "injected": "change of plans"
        }
      ],
      "expect": [
        {
          "op": "register",
          "registered": true
        },
        {
          "count": 1,
          "key": "p",
          "op": "live"
        },
        {
          "accepted": true,
          "ids": [
            "deleg_core_1"
          ],
          "key": "p",
          "op": "steer",
          "summary": "steer accepted; force-backgrounded 1 delegation(s): deleg_core_1"
        },
        {
          "op": "released",
          "value": true
        },
        {
          "op": "notice",
          "text": "The user sent a new message while this subagent was still running, so it was moved to the background as delegation deleg_core_1 - it was NOT stopped and its result will re-enter this conversation as a completion message when it finishes. The user's message follows as a steer; respond to it now rather than waiting for the background result."
        },
        {
          "op": "receipt",
          "text": "🌀 Your message moved the running agent to the background (delegation deleg_core_1).\nInjected into the agent's context:\n```\nchange of plans\n```"
        }
      ]
    },
