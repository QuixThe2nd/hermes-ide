        {"id": "weird-2", "kind": "tuple", "tag": "__gate__", "arity": 3}
      ],
      "service": ["flush-1"],
      "kept": ["weird-1", "weird-2"],
      "parkable": false
    },
    {
      "name": "reset_and_hold_markers_stay_put",
      "queue": [
        {"id": "reset-1", "kind": "reset"},
        {"id": "hold-1", "kind": "hold", "tag": "__gate__"},
