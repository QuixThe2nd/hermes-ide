        {"id": "hold-1", "kind": "hold", "tag": "__gate__"},
        {"id": "flush-3", "kind": "flush"}
      ],
      "service": ["flush-1", "flush-2", "flush-3"],
      "kept": ["row-a", "hold-1"],
      "parkable": false
