      ],
      "service": [],
      "kept": ["card-1", "hold-1", "row-a"],
      "parkable": true
    },
    {
      "name": "multiple_flushes_service_in_fifo_order",
      "queue": [
        {"id": "flush-1", "kind": "flush"},
        {"id": "row-a", "kind": "row"},
