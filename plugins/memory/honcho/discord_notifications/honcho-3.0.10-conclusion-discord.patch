+class RecordingAsyncClient:
+    def __init__(
+        self,
+        responses: dict[str, list[httpx.Response | Exception]] | None = None,
+    ):
+        self._responses = responses or {}
+        self._call_counts: dict[str, int] = {}
+        self.calls: list[dict[str, Any]] = []
+
+    async def __aenter__(self) -> "RecordingAsyncClient":
+        return self
+
+    async def __aexit__(
+        self, exc_type: object, exc: object, tb: object
+    ) -> None:  # pragma: no cover
+        _ = (exc_type, exc, tb)
+
+    async def post(
+        self,
+        url: str,
+        *,
+        content: str | None = None,
+        json: dict[str, Any] | None = None,
+        headers: dict[str, str] | None = None,
+    ) -> httpx.Response:
+        self.calls.append(
+            {
+                "url": url,
+                "content": content,
+                "json": json,
+                "headers": headers or {},
+            }
+        )
+        call_index = self._call_counts.get(url, 0)
+        self._call_counts[url] = call_index + 1
+        queue = self._responses.get(url, [])
+        if call_index >= len(queue):
+            return httpx.Response(
+                200, request=httpx.Request("POST", url), content=b"{}"
+            )
+        result = queue[call_index]
+        if isinstance(result, Exception):
+            raise result
+        return result
+
