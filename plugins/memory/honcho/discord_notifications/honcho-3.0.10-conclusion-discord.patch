+def test_build_discord_embed_batches_respects_limits() -> None:
+    long_content = "x" * 5000
+    payload = WebhookPayload(
+        event_type=WebhookEventType.CONCLUSION_CREATED.value,
+        data={
+            "workspace_id": "ws_1",
+            "level": "explicit",
+            "conclusions": [
+                {
+                    "id": f"doc_{index}",
+                    "content": long_content,
+                    "observer": "observer",
+                    "observed": "observed",
+                    "session_name": "session",
+                    "created_at": "2026-01-01T00:00:00+00:00",
+                }
+                for index in range(15)
+            ],
+        },
+    )
+
+    batches = webhook_delivery._build_discord_embed_batches(payload, "ws_1")  # pyright: ignore[reportPrivateUsage]
+    assert batches
+    total_embeds = sum(len(batch) for batch in batches)
+    assert total_embeds == 15
+
+    for batch in batches:
+        assert len(batch) <= webhook_delivery.DISCORD_MAX_EMBEDS_PER_MESSAGE
+        total_chars = sum(
+            webhook_delivery._embed_char_count(embed)  # pyright: ignore[reportPrivateUsage]
+            for embed in batch
+        )
+        assert total_chars <= webhook_delivery.DISCORD_MAX_CHARS_PER_MESSAGE
+        for embed in batch:
+            assert (
+                len(embed.get("description", ""))
+                <= webhook_delivery.DISCORD_MAX_DESCRIPTION
+            )
+            for field in embed.get("fields", []):
+                assert len(field["name"]) <= webhook_delivery.DISCORD_MAX_FIELD_NAME
+                assert len(field["value"]) <= webhook_delivery.DISCORD_MAX_FIELD_VALUE
+            assert len(embed.get("fields", [])) <= webhook_delivery.DISCORD_MAX_FIELDS
+
