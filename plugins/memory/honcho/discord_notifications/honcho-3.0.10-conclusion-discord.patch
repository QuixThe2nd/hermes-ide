+def _build_conclusion_embed(
+    *,
+    level: DocumentLevel,
+    workspace_name: str,
+    conclusion: dict[str, Any],
+) -> dict[str, Any]:
+    config = _LEVEL_EMBED_CONFIG[level]
+    fields: list[dict[str, Any]] = [
+        {
+            "name": _truncate("Level", DISCORD_MAX_FIELD_NAME),
+            "value": _truncate(level, DISCORD_MAX_FIELD_VALUE),
+            "inline": True,
+        },
+        {
+            "name": _truncate("Observer", DISCORD_MAX_FIELD_NAME),
+            "value": _truncate(
+                str(conclusion.get("observer", "")), DISCORD_MAX_FIELD_VALUE
+            ),
+            "inline": True,
+        },
+        {
+            "name": _truncate("About", DISCORD_MAX_FIELD_NAME),
+            "value": _truncate(
+                str(conclusion.get("observed", "")), DISCORD_MAX_FIELD_VALUE
+            ),
+            "inline": True,
+        },
+        {
+            "name": _truncate("Workspace", DISCORD_MAX_FIELD_NAME),
+            "value": _truncate(workspace_name, DISCORD_MAX_FIELD_VALUE),
+            "inline": True,
+        },
+        {
+            "name": _truncate("Document ID", DISCORD_MAX_FIELD_NAME),
+            "value": _truncate(str(conclusion.get("id", "")), DISCORD_MAX_FIELD_VALUE),
+            "inline": True,
+        },
+        {
+            "name": _truncate("Created", DISCORD_MAX_FIELD_NAME),
+            "value": _truncate(
+                str(conclusion.get("created_at", "")),
+                DISCORD_MAX_FIELD_VALUE,
+            ),
+            "inline": True,
+        },
+    ]
+
+    session_name = conclusion.get("session_name")
+    if session_name:
+        fields.append(
+            {
+                "name": _truncate("Session", DISCORD_MAX_FIELD_NAME),
+                "value": _truncate(str(session_name), DISCORD_MAX_FIELD_VALUE),
+                "inline": True,
+            }
+        )
+
+    fields = fields[:DISCORD_MAX_FIELDS]
+
+    description = _truncate(str(conclusion.get("content", "")), DISCORD_MAX_DESCRIPTION)
+    embed: dict[str, Any] = {
+        "title": _truncate(config["title"], DISCORD_MAX_TITLE),
+        "description": description,
+        "color": config["color"],
+        "fields": fields,
+    }
+
+    if _embed_char_count(embed) > DISCORD_MAX_CHARS_PER_MESSAGE:
+        overhead = _embed_char_count({**embed, "description": ""})
+        allowed_description = max(
+            0, DISCORD_MAX_CHARS_PER_MESSAGE - overhead - len("...")
+        )
+        embed["description"] = _truncate(description, allowed_description)
+
+    return embed
+
+
+def _chunk_discord_embeds(embeds: list[dict[str, Any]]) -> list[list[dict[str, Any]]]:
+    batches: list[list[dict[str, Any]]] = []
+    current_batch: list[dict[str, Any]] = []
+    current_chars = 0
+
+    for embed in embeds:
+        embed_chars = _embed_char_count(embed)
+        batch_full = len(current_batch) >= DISCORD_MAX_EMBEDS_PER_MESSAGE
+        would_exceed = current_batch and (
+            current_chars + embed_chars > DISCORD_MAX_CHARS_PER_MESSAGE
+        )
+        if batch_full or would_exceed:
+            batches.append(current_batch)
+            current_batch = []
+            current_chars = 0
+
+        current_batch.append(embed)
+        current_chars += embed_chars
+
+    if current_batch:
+        batches.append(current_batch)
+
+    return batches
+
+
+def _build_discord_embed_batches(
+    payload: WebhookPayload,
+    workspace_name: str,
+) -> list[list[dict[str, Any]]]:
+    level = payload.data.get("level")
+    conclusions = payload.data.get("conclusions")
+    if not isinstance(level, str) or not isinstance(conclusions, list):
+        raise ValueError("Invalid conclusion.created payload")
+
+    if level not in _LEVEL_EMBED_CONFIG:
+        raise ValueError(f"Unsupported conclusion level: {level}")
+
+    embeds = [
+        _build_conclusion_embed(
+            level=level,  # type: ignore[arg-type]
+            workspace_name=workspace_name,
+            conclusion=conclusion,
+        )
+        for conclusion in conclusions
+        if isinstance(conclusion, dict)
+    ]
+    return _chunk_discord_embeds(embeds)
+
