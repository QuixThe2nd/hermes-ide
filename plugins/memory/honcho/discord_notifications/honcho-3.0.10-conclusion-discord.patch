+async def _post_discord_payload(
+    client: httpx.AsyncClient,
+    url: str,
+    payload: dict[str, Any],
+    *,
+    level: str,
+    event_type: str,
+) -> None:
+    status_code: int | None = None
+    reason = "network_error"
+
+    for attempt in range(1, DISCORD_MAX_ATTEMPTS + 1):
+        try:
+            response = await client.post(
+                url,
+                json=payload,
+                headers={"User-Agent": DISCORD_USER_AGENT},
+            )
+        except httpx.RequestError:
+            status_code = None
+            reason = "network_error"
+            if attempt >= DISCORD_MAX_ATTEMPTS:
+                break
+            await asyncio.sleep(DISCORD_INITIAL_BACKOFF_SECONDS * attempt)
+            continue
+
+        if 200 <= response.status_code < 300:
+            logger.debug(
+                "Delivered Discord webhook for event=%s level=%s status=%s",
+                event_type,
+                level,
+                response.status_code,
+            )
+            return
+
+        status_code = response.status_code
+
+        if response.status_code == 429:
+            reason = "rate_limited"
+            if attempt >= DISCORD_MAX_ATTEMPTS:
+                break
+            await asyncio.sleep(_parse_discord_retry_after(response))
+            continue
+
+        if response.status_code >= 500:
+            reason = "server_error"
+            if attempt >= DISCORD_MAX_ATTEMPTS:
+                break
+            await asyncio.sleep(DISCORD_INITIAL_BACKOFF_SECONDS * attempt)
+            continue
+
+        reason = "client_error"
+        break
+
+    raise DiscordDeliveryError(
+        level=level,
+        status_code=status_code,
+        attempts=DISCORD_MAX_ATTEMPTS,
+        reason=reason,
+    ) from None
+
+
+def _parse_discord_retry_after(response: httpx.Response) -> float:
+    retry_after_header = response.headers.get("Retry-After")
+    if retry_after_header:
+        try:
+            return min(float(retry_after_header), 60.0)
+        except ValueError:
+            pass
+
+    try:
+        body = response.json()
+        retry_after = body.get("retry_after")
+        if isinstance(retry_after, (int, float)):
+            return min(float(retry_after), 60.0)
     except Exception:
-        logger.exception("Unexpected error delivering webhook.")
+        pass
+
+    return 1.0
+
